---
const { article, index } = Astro.props;
const reviewed = new Date(article.lastReviewed ?? article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const tag = typeof index === 'number' ? `Part ${String(index).padStart(2, '0')} · ${article.category}` : article.category;
---
<a href={'/guides/' + article.slug + '/'} class="article-card">
  <div class="article-card__top"><span>{tag}</span><span>{article.readTime}</span></div>
  <h3>{article.title}</h3>
  <p>{article.description}</p>
  <div class="article-card__footer"><span>Reviewed {reviewed}</span><span>Read guide</span></div>
</a>
