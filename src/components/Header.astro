---
const { currentPath = '/' } = Astro.props;
const nav = [
  { href: '/guides/', label: 'Guides' },
  { href: '/tools/', label: 'Calculators' },
  { href: '/topics/', label: 'Topics' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' }
];
const isCurrent = (href: string) => currentPath === href || currentPath === href.slice(0, -1) || (href !== '/' && currentPath.startsWith(href));
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="LiquidityPools.app home"><span class="brand-mark" aria-hidden="true"></span><span>LiquidityPools<em>.app</em></span></a>
    <nav class="nav-links" aria-label="Main navigation">
      {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="nav-cta" href="/tools/impermanent-loss-calculator/" data-cta="nav_calculator">Open a calculator</a>
    <details class="mobile-nav">
      <summary aria-label="Open menu"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>Menu</summary>
      <nav class="mobile-nav__panel" aria-label="Mobile navigation">
        {nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>)}
        <a class="is-cta" href="/tools/impermanent-loss-calculator/" data-cta="nav_calculator">Open a calculator</a>
      </nav>
    </details>
  </div>
</header>
