---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles, articleBySlug, trackInfoForArticle } from '../../lib/articles';
import { editorialTeam } from '../../lib/editorial';
import { toolForGuide } from '../../lib/tools';

export function getStaticPaths() { return articles.map((article) => ({ params: { slug: article.slug } })); }
const article = articleBySlug(Astro.params.slug!);
if (!article) throw new Error('Article not found');
const Content = article.Content;
const trackInfo = trackInfoForArticle(article.slug);
const trackArticles = trackInfo ? trackInfo.track : [];
const trackIndex = trackInfo ? trackInfo.index : 1;
const nextArticle = trackInfo ? trackInfo.next : null;
const prevArticle = trackInfo ? trackInfo.prev : null;
const related = trackInfo
  ? ([trackInfo.next, trackInfo.prev, trackArticles[trackIndex + 1]].filter(Boolean) as typeof trackArticles)
  : [];
const keywordSet = new Set(article.keywords.split(',').map((k) => k.trim().toLowerCase()).filter(Boolean));
const crossTrackRelated = articles
  .filter((item) => item.slug !== article.slug && item.category !== article.category)
  .map((item) => ({
    item,
    score: item.keywords.split(',').filter((k) => keywordSet.has(k.trim().toLowerCase())).length,
  }))
  .filter((entry) => entry.score > 0)
  .sort((a, b) => b.score - a.score || a.item.title.localeCompare(b.item.title))
  .slice(0, 3)
  .map((entry) => entry.item);
const articleImage = '/images/guides/' + article.slug + '.webp';
const reviewedDate = article.lastReviewed ?? article.date;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  dateModified: reviewedDate,
  mainEntityOfPage: `https://liquiditypools.app/guides/${article.slug}/`,
  image: 'https://liquiditypools.app' + articleImage,
  author: {
    '@type': 'Organization',
    name: editorialTeam.name,
    description: editorialTeam.bio,
    url: editorialTeam.url
  },
  publisher: {
    '@type': 'Organization',
    name: editorialTeam.publisher,
    url: 'https://liquiditypools.app',
    logo: { '@type': 'ImageObject', url: 'https://liquiditypools.app/favicon.svg' }
  },
  articleSection: article.category,
  keywords: article.keywords,
  inLanguage: 'en-US',
  isAccessibleForFree: true
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liquiditypools.app/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://liquiditypools.app/guides/' },
    { '@type': 'ListItem', position: 3, name: article.title, item: `https://liquiditypools.app/guides/${article.slug}/` }
  ]
};
const faq = article.faq ?? [];
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  : null;
const trackAnchor = '/guides/#' + article.category.toLowerCase().replaceAll(' ', '-').replace('&', 'and');
const tool = toolForGuide(article);
---
<BaseLayout title={article.title + ' — LiquidityPools.app'} description={article.description} type="article" image={articleImage} imageAlt={article.description} author={editorialTeam.name} publishedTime={article.date} modifiedTime={reviewedDate}>
  <Fragment slot="head"><link rel="stylesheet" href="/katex/katex.min.css" /><script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} /><script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />{faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}</Fragment>
  <section class="article-hero"><div class="container article-hero__grid"><div><p class="eyebrow"><a class="eyebrow-link" href={trackAnchor}>{article.category}</a>, guide {trackIndex} of {trackArticles.length}</p><h1>{article.title}</h1><p class="dek">{article.description}</p></div><div class="article-meta"><div>Published<strong>{new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</strong></div><div>Last reviewed<strong>{new Date(reviewedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</strong></div><div>By<strong><a href="/about/#editorial-policy">{editorialTeam.name}</a></strong></div><div>Reading time<strong>{article.readTime}</strong></div></div></div></section>
  <article class="container article-layout"><aside class="article-rail"><div><h2>Track Progress</h2><p><strong>{article.category}</strong><br />Part {trackIndex} of {trackArticles.length} in this sequence.</p><p style="margin-top:6px"><a href="/topics/">View the reading order</a></p></div><div><h2>On this page</h2><nav class="toc" data-toc aria-label="On this page"></nav></div><div><h2>Research standard</h2><p>Mechanism first. Material claims are sourced. Outcomes remain conditional.</p></div><div><h2>Related in Track</h2>{related.map((item) => <a href={'/guides/' + item.slug + '/'}>{item.title}</a>)}</div>{crossTrackRelated.length > 0 && <div><h2>Related across tracks</h2>{crossTrackRelated.map((item) => <a href={'/guides/' + item.slug + '/'}>{item.title}</a>)}</div>}</aside><div class="article-content"><nav class="toc toc--mobile" data-toc aria-label="On this page"></nav><Content /><aside class="tool-callout" data-tool-callout><div class="tool-callout__eyebrow">Run your own numbers</div><p><strong>{tool.title}.</strong> {tool.prompt}</p><a class="tool-callout__link" href={tool.href} data-cta="guide_tool_callout">Open the calculator</a></aside><script is:inline>
    (function () {
      // Lift the calculator prompt to just before the guide's second section, so it sits in the
      // first quarter of the read instead of after it. Without JS it stays at the end of the body.
      var callout = document.currentScript.previousElementSibling;
      var sections = callout.parentElement.querySelectorAll(':scope > h2');
      if (sections.length > 2) sections[1].parentElement.insertBefore(callout, sections[1]);
    })();
  </script>{faq.length > 0 && (
    <div class="faq-block">
      <h2>Frequently asked questions</h2>
      {faq.map((item) => (
        <details class="faq-item">
          <summary><h3>{item.q}</h3></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  )}<div class="article-author-card"><div class="article-author-card__content"><div class="article-author-card__eyebrow">Published by SudoAI</div><h3 class="article-author-card__name"><a href="/about/#editorial-policy">{editorialTeam.name}</a></h3><p class="article-author-card__bio">{editorialTeam.bio} <a href="/about/#editorial-policy">Read the editorial policy.</a></p></div></div><div class="article-end" data-guide-end={article.slug}><h2>Continue in this track</h2><p>This is guide {trackIndex} of {trackArticles.length} in <strong>{article.category}</strong>.</p>{nextArticle && <p style="margin-top:8px"><strong>Next:</strong> <a href={'/guides/' + nextArticle.slug + '/'}><strong>{nextArticle.title}</strong> →</a></p>}{prevArticle && <p style="margin-top:4px"><strong>Previous:</strong> <a href={'/guides/' + prevArticle.slug + '/'}>← {prevArticle.title}</a></p>}<p style="margin-top:8px"><a href={trackAnchor}><strong>See the full track sequence</strong></a>, or browse <a href="/guides/">all {articles.length} guides</a>.</p></div></div><aside class="article-rail"><div><h2>Byline</h2><p><strong><a href="/about/#editorial-policy">{editorialTeam.name}</a></strong><br /><span class="article-rail__note">Published by SudoAI</span></p></div><div><h2>Data sources we use</h2><p class="article-rail__note" style="margin-bottom:6px">Public data for independent verification:</p><a href="https://revert.finance" target="_blank" rel="noopener">Revert Finance ↗</a><a href="https://dune.com" target="_blank" rel="noopener">Dune Analytics ↗</a><a href="https://defillama.com" target="_blank" rel="noopener">DeFiLlama Yields ↗</a></div><div><h2>Editorial note</h2><p>This guide is educational and general in nature. It is not investment, legal, tax, or financial advice.</p></div><div><h2>Method</h2><p><a href="/about/#editorial-policy">How LiquidityPools.app drafts, checks, reviews, and corrects its work.</a></p></div></aside></article>
  <dialog class="figure-dialog" data-figure-dialog aria-label="Enlarged figure"><form method="dialog"><button class="figure-dialog__close" aria-label="Close enlarged figure">Close ✕</button></form><img alt="" /></dialog>
  <script is:inline>
    (function () {
      // Readers click the editorial figures expecting to zoom in; give that click a result.
      var dialog = document.querySelector('[data-figure-dialog]');
      if (!dialog || typeof dialog.showModal !== 'function') return;
      var large = dialog.querySelector('img');
      Array.prototype.forEach.call(document.querySelectorAll('.article-content .article-figure img'), function (img) {
        img.classList.add('is-zoomable');
        img.setAttribute('tabindex', '0');
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', 'Enlarge figure: ' + (img.getAttribute('alt') || ''));
        function open() {
          large.src = img.currentSrc || img.src;
          large.alt = img.alt;
          dialog.showModal();
        }
        img.addEventListener('click', open);
        img.addEventListener('keydown', function (event) {
          if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); }
        });
      });
      dialog.addEventListener('click', function (event) { if (event.target === dialog || event.target === large) dialog.close(); });
    })();
  </script>
  <script is:inline>
    (function () {
      // Build the in-page contents list from the guide's own H2s (heading ids are set at render).
      var content = document.querySelector('.article-content');
      if (!content) return;
      var headings = content.querySelectorAll(':scope > h2[id]');
      if (headings.length < 3) return;
      var links = [];
      Array.prototype.forEach.call(headings, function (heading) {
        var text = (heading.textContent || '').trim();
        if (!text || text === 'Frequently asked questions') return;
        links.push({ id: heading.id, text: text });
      });
      if (links.length < 3) return;
      Array.prototype.forEach.call(document.querySelectorAll('[data-toc]'), function (nav) {
        var list = document.createElement('ol');
        links.forEach(function (entry) {
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + entry.id;
          a.textContent = entry.text;
          li.appendChild(a);
          list.appendChild(li);
        });
        nav.appendChild(list);
        nav.hidden = false;
      });
    })();
  </script>
</BaseLayout>
