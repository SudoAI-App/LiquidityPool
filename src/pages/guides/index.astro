---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles, categories, categoryArticles } from '../../lib/articles';
import { toolCatalog } from '../../lib/tools';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liquiditypools.app/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://liquiditypools.app/guides/' }
  ]
};
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `DeFi Liquidity Guides (${articles.length}) — LiquidityPools.app`,
  url: 'https://liquiditypools.app/guides/',
  description: `Comprehensive directory of ${articles.length} peer-reviewed DeFi liquidity guides.`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://liquiditypools.app/guides/${article.slug}/`
    }))
  }
};
---
<BaseLayout title={`DeFi Liquidity Guides (${articles.length}) — LiquidityPools.app`} description={`Explore ${articles.length} peer-reviewed guides about liquidity pools, AMMs, LP strategies, impermanent loss, liquidity mining, and DeFi risk research.`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <section class="page-hero"><div class="container"><p class="eyebrow">Guides</p><h1 class="page-title">All {articles.length} guides, in reading order.</h1><p>Four tracks, from how a pool prices a trade through to concentrated liquidity, onchain metrics and market structure. Every guide is dated, sourced and reviewed before publication.</p><div class="category-nav">{categories.map((category) => <a class="category-pill" href={'#' + category.toLowerCase().replaceAll(' ', '-').replace('&', 'and')}>{category}</a>)}</div><div class="hero-tools"><span>Prefer to run the numbers?</span>{Object.values(toolCatalog).map((tool) => <a href={tool.href} data-cta="guides_hero_tool">{tool.title}</a>)}</div></div></section>
  <section class="section section--paper"><div class="container"><div class="guide-layout"><aside class="guide-aside"><h2>Navigate by track</h2>{categories.map((category) => <a href={'#' + category.toLowerCase().replaceAll(' ', '-').replace('&', 'and')}>{category}</a>)}</aside><div>{categories.map((category) => <section class="guide-group" id={category.toLowerCase().replaceAll(' ', '-').replace('&', 'and')}><div class="section-head"><div><div class="kicker">Track {categories.indexOf(category) + 1} · {categoryArticles(category).length} guides</div><h2>{category === 'Foundations' ? 'Foundations: how a pool works.' : category === 'LP Mechanics' ? 'LP mechanics: what a position does.' : category === 'Risk & Research' ? 'Risk and research: what it can cost.' : 'Advanced: the wider market.'}</h2></div></div><div class="guide-list">{categoryArticles(category).map((article, idx) => <ArticleCard article={article} index={idx + 1} />)}</div></section>)}</div></div></div></section>
</BaseLayout>
