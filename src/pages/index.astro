---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, articleBySlug } from '../lib/articles';
import { authors } from '../lib/authors';
import { toolCatalog } from '../lib/tools';
const latest = articles.slice(0, 6);
const authorList = Object.values(authors);
const tools = [
  { ...toolCatalog.impermanentLoss, eyebrow: 'Risk · Divergence' },
  { ...toolCatalog.poolFees, eyebrow: 'Revenue · Fee modelling' },
  { ...toolCatalog.lpProfit, eyebrow: 'Outcome · Net result' },
  { ...toolCatalog.uniswapV3, eyebrow: 'Range · Concentrated positions' }
];
const questions = [
  { slug: 'what-is-a-liquidity-pool', lead: 'New to DeFi?', ask: 'What is a liquidity pool?' },
  { slug: 'can-you-lose-money-in-a-liquidity-pool', lead: 'Worried about losses?', ask: 'Can I lose money as an LP?' },
  { slug: 'is-providing-liquidity-profitable', lead: 'Weighing the return?', ask: 'Is providing liquidity profitable?' }
];
// The questions readers search for most, one link each, so every cluster is reachable from the homepage.
const commonQuestions = [
  'how-to-provide-liquidity', 'automated-market-maker-explained', 'liquidity-pool-tokens', 'liquidity-pool-types',
  'impermanent-loss-explained', 'impermanent-loss-formula', 'how-to-avoid-impermanent-loss', 'liquidity-pool-risks',
  'concentrated-liquidity-explained', 'out-of-range-liquidity', 'apr-vs-apy-in-defi', 'liquidity-pool-vs-staking',
  'slippage-and-price-impact', 'yield-farming-explained', 'uniswap-v3-vs-v4', 'liquidity-pools-for-beginners'
].map((slug) => {
  const article = articleBySlug(slug);
  if (!article) throw new Error(`Homepage links to a guide that does not exist: ${slug}`);
  return article;
});
for (const question of questions) {
  if (!articleBySlug(question.slug)) throw new Error(`Homepage links to a guide that does not exist: ${question.slug}`);
}
---
<BaseLayout title="Liquidity Pools Explained: AMMs, Impermanent Loss & LP Risk" description="A precise field guide to liquidity pools, automated market makers, impermanent loss, and onchain liquidity research, with free calculators for LP fee income and divergence." image="/images/liquiditypool-hero.webp">
  <section class="hero">
    <div class="hero-visual" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow eyebrow--mint">Free guides &amp; calculators for liquidity providers</div>
        <h1 class="display">Where liquidity<br />becomes <em>legible.</em></h1>
        <p>Plain-English guides to how liquidity pools work, what impermanent loss costs you and whether fees cover it, plus free calculators that run in your browser. No wallet, no sign-up.</p>
        <nav class="hero-questions" aria-label="Start with a question">
          {questions.map((item) => (
            <a href={`/guides/${item.slug}/`} data-cta="home_question"><span>{item.lead}</span><strong>{item.ask} <em aria-hidden="true">↗</em></strong></a>
          ))}
        </nav>
      </div>
      <aside class="hero-calc" aria-labelledby="hero-calc-title">
        <form data-calculator="impermanent_loss_mini" novalidate>
          <div class="eyebrow eyebrow--mint" id="hero-calc-title">Quick check · Impermanent loss</div>
          <p class="hero-calc__note">Token price when you deposited, and now. Paired with a stablecoin.</p>
          <div class="hero-calc__fields">
            <label>At deposit<input id="mini-p0" type="number" inputmode="decimal" step="any" min="0" value="2000" /></label>
            <label>Now<input id="mini-p1" type="number" inputmode="decimal" step="any" min="0" value="3000" /></label>
          </div>
          <output class="hero-calc__result" for="mini-p0 mini-p1" aria-live="polite"><strong id="mini-il">−2.02%</strong><span id="mini-note">A $10,000 deposit trails holding by $252.55 before fees.</span></output>
          <a class="text-link" href="/tools/impermanent-loss-calculator/" data-cta="home_mini_calculator">Add fees in the full calculator <span aria-hidden="true">↗</span></a>
        </form>
      </aside>
    </div>
  </section>
  <div class="ticker"><div class="container ticker-track"><span>Liquidity pools</span><span class="ticker-dot"></span><span>AMM mechanics</span><span class="ticker-dot"></span><span>Risk frameworks</span><span class="ticker-dot"></span><span>Onchain research</span><span class="ticker-dot"></span><span>Free LP calculators</span><span class="ticker-dot"></span><span>For learners &amp; builders</span></div></div>

  <section class="section section--mist section--tight">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">Calculators</div><h2 class="section-title display">Model the position before you fund it.</h2></div>
        <p class="section-intro">Four calculators that state their formula and their limits on the same page. Everything runs locally; nothing is stored.</p>
      </div>
      <div class="article-grid article-grid--tools">
        {tools.map((tool) => (
          <a class="tool-card" href={tool.href} data-cta="home_tool_card">
            <div class="feature-card__meta" style="color:#537063"><span>{tool.eyebrow}</span></div>
            <h3>{tool.title}</h3>
            <p>{tool.prompt}</p>
            <span class="tool-card__status">Live · runs in your browser</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">The essential reads</div><h2 class="section-title display">A sharper way to enter the pool.</h2></div>
        <p class="section-intro">Begin with the mechanism, then move into LP decisions and risk. The library is intentionally sequenced—not a feed built for noise.</p>
      </div>
      <div class="feature-grid">
        <a href="/guides/impermanent-loss-explained/" class="feature-card feature-card--image">
          <div class="feature-card__meta"><span>Risk &amp; Research</span><span>9 min read</span></div>
          <div class="feature-card__body"><h3>Impermanent Loss, Explained Without the Hand-Waving</h3><p>Understand the rebalancing effect, compare outcomes cleanly, and see why fees only offset—not erase—risk.</p><span class="text-link">Read the guide <span>↗</span></span></div>
        </a>
        <div class="feature-stack">
          <a href="/guides/what-is-a-liquidity-pool/" class="feature-card feature-card--small">
            <div class="feature-card__meta"><span>Foundations</span><span>7 min read</span></div>
            <div class="feature-card__body"><h3>What Is a Liquidity Pool?</h3><p>The cleanest starting point for learning how a DEX can trade without a traditional order book.</p><span class="text-link">Start here <span>↗</span></span></div>
          </a>
          <a href="/guides/how-to-evaluate-a-liquidity-pool/" class="feature-card feature-card--small" style="background:#284838">
            <div class="feature-card__meta"><span>Research method</span><span>11 min read</span></div>
            <div class="feature-card__body"><h3>Evaluate a Pool Before You Supply It</h3><p>A five-part research framework built around market structure, incentives, and execution.</p><span class="text-link">Use the framework <span>↗</span></span></div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist section--tight">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Common questions</div><h2 class="section-title display">Find the guide for your question.</h2></div><a class="text-link" href="/topics/">See the reading order <span>↗</span></a></div>
      <ul class="question-list">
        {commonQuestions.map((article) => (
          <li><a href={`/guides/${article.slug}/`} data-cta="home_common_question"><span>{article.category}</span>{article.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow eyebrow--mint">The library, organized</div><h2 class="section-title display">Four tracks. One coherent mental model.</h2></div><a class="text-link" href="/topics/">See every track <span>↗</span></a></div>
      <div class="track-grid">
        <a class="track" href="/guides/#foundations"><span class="track__number">01 / FOUNDATIONS</span><h3>Start with the system.</h3><p>Build a durable vocabulary for pools, AMMs, LP tokens, and total value locked.</p></a>
        <a class="track" href="/guides/#lp-mechanics"><span class="track__number">02 / LP MECHANICS</span><h3>See the moving parts.</h3><p>Trace fees, concentrated liquidity, stable pools, and range-based positions.</p></a>
        <a class="track" href="/guides/#risk-research"><span class="track__number">03 / RISK &amp; RESEARCH</span><h3>Interrogate the trade-off.</h3><p>Study impermanent loss, smart-contract exposure, MEV, and due diligence.</p></a>
        <a class="track" href="/guides/#advanced"><span class="track__number">04 / ADVANCED</span><h3>Think like a market.</h3><p>Connect liquidity incentives, market-making logic, cross-chain design, and analytics.</p></a>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Recently added to the field guide</div><h2 class="section-title display">Read the underlying mechanics.</h2></div><a class="text-link" href="/guides/">Browse all {articles.length} guides <span>↗</span></a></div>
      <div class="article-grid">{latest.map((article) => <ArticleCard article={article} />)}</div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">Quantitative &amp; Microstructure Specialists</div><h2 class="section-title display">Authored by practitioners, not algorithms.</h2></div>
        <p class="section-intro">Every guide is produced by domain specialists with backgrounds in options market making, HFT order flow, EVM systems engineering, and institutional DeFi treasury management.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;margin-top:32px">
        {authorList.map((author) => (
          <div class="article-author-card" style="margin-top:0">
            <div class="article-author-card__avatar">{author.initials}</div>
            <div class="article-author-card__content">
              <div class="article-author-card__eyebrow">{author.role}</div>
              <h3 class="article-author-card__name"><a href={`/about/#${author.id}`} style="color:inherit;text-decoration:none">{author.name}</a></h3>
              <div class="article-author-card__credentials">{author.credentials}</div>
              <p class="article-author-card__bio" style="font-size:12.5px">{author.bio.slice(0, 140)}...</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper"><div class="container"><div class="newsletter"><div><div class="eyebrow eyebrow--mint">The weekly brief</div><h2>One considered dispatch for people who prefer signal to churn.</h2></div><div class="newsletter-note"><strong>Coming soon.</strong><p>We are building a concise research note for builders, LPs, and serious learners. Until then, the entire launch library is open to read.</p><a class="button button--mint" href="/guides/">Read all {articles.length} guides <span>↗</span></a></div></div></div></section>
  <script is:inline>
    (function () {
      var p0 = document.getElementById('mini-p0');
      var p1 = document.getElementById('mini-p1');
      var il = document.getElementById('mini-il');
      var note = document.getElementById('mini-note');
      if (!p0 || !p1) return;
      function render() {
        var a = parseFloat(p0.value), b = parseFloat(p1.value);
        if (!(a > 0) || !(b >= 0)) {
          il.textContent = '—';
          note.textContent = 'Enter a positive deposit price.';
          return;
        }
        var k = b / a;
        var loss = k > 0 ? 2 * Math.sqrt(k) / (1 + k) - 1 : -1;
        var hodl = 5000 * k + 5000;
        var gap = Math.abs(hodl * loss);
        il.textContent = (loss < -0.000005 ? '−' : '') + Math.abs(loss * 100).toFixed(2) + '%';
        note.textContent = gap < 0.005
          ? 'No divergence: prices have not moved relative to each other.'
          : 'A $10,000 deposit trails holding by $' + gap.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' before fees.';
      }
      p0.addEventListener('input', render);
      p1.addEventListener('input', render);
      render();
    })();
  </script>
</BaseLayout>
