---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, articleBySlug, categories, categoryArticles } from '../lib/articles';
import { toolCatalog } from '../lib/tools';
const latest = articles.slice(0, 6);
const tools = [
  { ...toolCatalog.impermanentLoss, eyebrow: 'Divergence against holding' },
  { ...toolCatalog.lpProfit, eyebrow: 'Net result on one ledger' },
  { ...toolCatalog.poolFees, eyebrow: 'Fee and incentive APR' },
  { ...toolCatalog.uniswapV3, eyebrow: 'Bounded price ranges' },
  { ...toolCatalog.meteoraDlmm, eyebrow: 'Discrete bins on Solana' }
];
const questions = [
  { slug: 'what-is-a-liquidity-pool', lead: 'New to DeFi', ask: 'What is a liquidity pool?' },
  { slug: 'can-you-lose-money-in-a-liquidity-pool', lead: 'Worried about losses', ask: 'Can I lose money as an LP?' },
  { slug: 'is-providing-liquidity-profitable', lead: 'Weighing the return', ask: 'Is providing liquidity profitable?' }
];
// The questions readers search for most, one link each, so every cluster is reachable from the homepage.
const commonQuestions = [
  'how-to-provide-liquidity', 'automated-market-maker-explained', 'liquidity-pool-tokens', 'liquidity-pool-types',
  'impermanent-loss-explained', 'impermanent-loss-formula', 'how-to-avoid-impermanent-loss', 'liquidity-pool-risks',
  'concentrated-liquidity-explained', 'out-of-range-liquidity', 'apr-vs-apy-in-defi', 'liquidity-pool-vs-staking',
  'slippage-and-price-impact', 'yield-farming-explained', 'uniswap-v3-vs-v4', 'liquidity-pools-for-beginners'
].map((slug) => {
  const article = articleBySlug(slug);
  if (!article) throw new Error(`Homepage links to a guide that does not exist: ${slug}`);
  return article;
});
for (const question of questions) {
  if (!articleBySlug(question.slug)) throw new Error(`Homepage links to a guide that does not exist: ${question.slug}`);
}
const featured = ['impermanent-loss-explained', 'what-is-a-liquidity-pool', 'how-to-evaluate-a-liquidity-pool'].map((slug) => {
  const article = articleBySlug(slug);
  if (!article) throw new Error(`Homepage features a guide that does not exist: ${slug}`);
  return article;
});
const trackCopy: Record<string, { title: string; body: string }> = {
  'Foundations': { title: 'Start with the system', body: 'Pools, AMMs, LP tokens and TVL, explained from the mechanism up.' },
  'LP Mechanics': { title: 'Follow the position', body: 'Fees, concentrated ranges, stable pools and what happens out of range.' },
  'Risk & Research': { title: 'Price the trade-off', body: 'Impermanent loss, contract exposure, MEV and pool due diligence.' },
  'Advanced': { title: 'Read the market', body: 'Incentives, market-making logic, cross-chain liquidity and analytics.' }
};
const anchor = (category: string) => '/guides/#' + category.toLowerCase().replaceAll(' ', '-').replace('&', 'and');
const latestReview = articles.map((a) => a.lastReviewed ?? a.date).sort().at(-1)!;
const latestReviewLabel = new Date(latestReview).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
// Impermanent loss at each price move, from the same formula the guide and calculator use.
const ilAt = (k: number) => 2 * Math.sqrt(k) / (1 + k) - 1;
const ilRows = [
  { move: 'Up 25%, or down 20%', k: 1.25 }, { move: 'Up 50%, or down a third', k: 1.5 },
  { move: 'Doubles or halves', k: 2 }, { move: 'Triples', k: 3 }, { move: 'Up 5×', k: 5 }
].map((row) => ({ move: row.move, il: `${(ilAt(row.k) * 100).toFixed(2)}%` }));
// Static curve so the hero chart renders before JavaScript runs.
const curvePoints = Array.from({ length: 41 }, (_, i) => {
  const k = 0.25 * Math.pow(16, i / 40);
  return `${(8 + i / 40 * 264).toFixed(1)},${(10 + ilAt(k) / -0.2 * 80).toFixed(1)}`;
}).join(' ');
const markerX = (8 + Math.log(1.5 / 0.25) / Math.log(16) * 264).toFixed(1);
const markerY = (10 + ilAt(1.5) / -0.2 * 80).toFixed(1);
---
<BaseLayout title="Liquidity Pools Explained: AMMs, Impermanent Loss & LP Risk" description="A precise field guide to liquidity pools, automated market makers, impermanent loss, and onchain liquidity research, with free calculators for LP fee income and divergence." image="/images/liquiditypool-hero.webp">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent research library, published by SudoAI</p>
        <h1>Understand a liquidity pool before you fund it.</h1>
        <p>{articles.length} guides and {tools.length} calculators for liquidity providers. Every formula is published, every material claim is cited to a primary source, and every page shows when it was last reviewed.</p>
        <div class="hero-actions">
          <a class="button button--mint" href="/guides/what-is-a-liquidity-pool/" data-cta="home_start">Start with the basics</a>
          <a class="button button--line" href="/tools/impermanent-loss-calculator/" data-cta="home_calculator">Open the impermanent loss calculator</a>
        </div>
      </div>
      <aside class="hero-calc" aria-labelledby="hero-calc-title">
        <form data-calculator="impermanent_loss_mini" novalidate>
          <h2 class="hero-calc__title" id="hero-calc-title">Impermanent loss, quick check</h2>
          <p class="hero-calc__note">Token price when you deposited and now, paired with a stablecoin.</p>
          <div class="hero-calc__fields">
            <label>Price at deposit<span class="field"><input id="mini-p0" type="number" inputmode="decimal" step="any" min="0" value="2000" /></span></label>
            <label>Price now<span class="field"><input id="mini-p1" type="number" inputmode="decimal" step="any" min="0" value="3000" /></span></label>
          </div>
          <figure class="hero-calc__chart" aria-hidden="true">
            <svg viewBox="0 0 280 112"><line class="axis" x1="8" y1="10" x2="272" y2="10" /><line class="axis" x1="8" y1="10" x2="8" y2="96" /><polyline class="curve" id="mini-curve" points={curvePoints} /><circle class="marker" id="mini-marker" r="4.5" cx={markerX} cy={markerY} /><text x="8" y="108">0.25×</text><text x="128" y="108">1×</text><text x="256" y="108">4×</text></svg>
          </figure>
          <output class="hero-calc__result" for="mini-p0 mini-p1" aria-live="polite"><strong id="mini-il">−2.02%</strong><span id="mini-note">$10,000 in the pool trails holding by $252.55 before fees.</span></output>
          <a class="text-link" href="/tools/impermanent-loss-calculator/" data-cta="home_mini_calculator">Add fees and a price range in the full calculator</a>
        </form>
      </aside>
    </div>
  </section>

  <section class="proof" aria-label="How this site earns trust">
    <div class="container proof-grid">
      <div class="proof-item"><strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 2.5h10v11H3zM5.5 6h5M5.5 8.5h5M5.5 11h3"/></svg>Formulas published</strong>Every calculator's equation, assumptions and worked test vectors are on the <a href="/methodology/">methodology page</a>.</div>
      <div class="proof-item"><strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5.5 4 2 8l3.5 4M10.5 4 14 8l-3.5 4"/></svg>Code and tests are public</strong>The calculator library and its unit tests are <a href="https://github.com/SudoAI-App/LiquidityPool/tree/main/src/lib/calculators" target="_blank" rel="noopener">open on GitHub</a>.</div>
      <div class="proof-item"><strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2.5 3.5h11M2.5 8h11M2.5 12.5h7"/></svg>Sources on every guide</strong>Each guide ends with numbered references to protocol specifications and research. <a href="/about/#editorial-policy">How guides are checked</a>.</div>
      <div class="proof-item"><strong><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 5v3.5l2 1.5"/></svg>Dated reviews</strong>Every guide shows its last review date. Most recent review: {latestReviewLabel}.</div>
    </div>
  </section>

  <section class="section section--tight section--paper">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">Where to start</div><h2 class="section-title">Most readers arrive with one of three questions.</h2></div>
        <a class="text-link" href="/topics/">See the full reading order</a>
      </div>
      <nav class="hero-questions" aria-label="Start with a question">
        {questions.map((item) => (
          <a href={`/guides/${item.slug}/`} data-cta="home_question"><span>{item.lead}</span><strong>{item.ask}</strong></a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section--mist section--rule">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">Calculators</div><h2 class="section-title">Model the position before you fund it.</h2></div>
        <p class="section-intro">Each calculator states its formula and its limits on the same page. Inputs stay in your browser: no wallet connection, no sign-up.</p>
      </div>
      <div class="article-grid article-grid--tools">
        {tools.map((tool) => (
          <a class="tool-card" href={tool.href} data-cta="home_tool_card">
            <div class="tool-card__eyebrow">{tool.eyebrow}</div>
            <h3>{tool.title}</h3>
            <p>{tool.prompt}</p>
            <span class="tool-card__status">Runs in your browser</span>
          </a>
        ))}
        <a class="tool-card" href="/methodology/" data-cta="home_methodology">
          <div class="tool-card__eyebrow">Verify the models</div>
          <h3>Methodology and test vectors</h3>
          <p>The formulas, assumptions and exclusions behind every calculator, with the fixed test cases the automated suite checks against.</p>
          <span class="tool-card__status">Reviewed with each formula change</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">Essential reads</div><h2 class="section-title">The mechanism first, then the decision.</h2></div>
        <p class="section-intro">Begin with how a pool moves, then move on to what a position costs and how to judge one before supplying it.</p>
      </div>
      <div class="feature-grid">
        <a href={`/guides/${featured[0].slug}/`} class="feature-card">
          <div class="feature-card__meta"><span>{featured[0].category}</span><span>{featured[0].readTime}</span></div>
          <div class="feature-card__body"><h3>{featured[0].title}</h3><p>{featured[0].description}</p></div>
          <table class="feature-table"><thead><tr><th>Price move since deposit</th><th>Loss versus holding, before fees</th></tr></thead><tbody>{ilRows.map((row) => <tr><td>{row.move}</td><td>{row.il}</td></tr>)}</tbody></table>
          <span class="text-link">Read the guide</span>
        </a>
        <div class="feature-stack">
          {featured.slice(1).map((article) => (
            <a href={`/guides/${article.slug}/`} class="feature-card feature-card--small">
              <div class="feature-card__meta"><span>{article.category}</span><span>{article.readTime}</span></div>
              <div class="feature-card__body"><h3>{article.title}</h3><p>{article.description}</p><span class="text-link">Read the guide</span></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist section--rule">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Common questions</div><h2 class="section-title">Find the guide for your question.</h2></div><a class="text-link" href="/guides/">Browse all {articles.length} guides</a></div>
      <ul class="question-list">
        {commonQuestions.map((article) => (
          <li><a href={`/guides/${article.slug}/`} data-cta="home_common_question"><span>{article.category}</span>{article.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head"><div><div class="kicker">The library, in reading order</div><h2 class="section-title">Four tracks, one model of how liquidity behaves.</h2></div><a class="text-link" href="/topics/">See every guide by track</a></div>
      <div class="track-grid">
        {categories.map((category, index) => (
          <a class="track" href={anchor(category)}><span class="track__number">Track {index + 1}: {category}</span><h3>{trackCopy[category].title}</h3><p>{trackCopy[category].body}</p><span class="track__count">{categoryArticles(category).length} guides</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head"><div><div class="kicker">Recently reviewed</div><h2 class="section-title">The latest additions to the library.</h2></div><a class="text-link" href="/guides/">Browse all {articles.length} guides</a></div>
      <div class="article-grid">{latest.map((article) => <ArticleCard article={article} />)}</div>
    </div>
  </section>

  <section class="section section--mist section--rule">
    <div class="container">
      <div class="section-head">
        <div><div class="kicker">How guides are made</div><h2 class="section-title">One byline, a public process, and a correction route.</h2></div>
      </div>
      <div class="process">
        <div class="process-steps">
          <div class="process-step"><div><h3>Draft</h3><p>Guides are written by the LiquidityPools Editorial Team and may use AI assistance to organise, draft or revise text. No guide is attributed to a fictional expert or an invented credential.</p></div></div>
          <div class="process-step"><div><h3>Check</h3><p>Material claims are checked against the numbered sources at the end of each guide: protocol whitepapers and documentation, peer-reviewed and preprint research, and public-sector analysis.</p></div></div>
          <div class="process-step"><div><h3>Review and date</h3><p>The SudoAI team reviews each guide before publication. The visible review date changes whenever a source, claim, mechanism or correction is reviewed.</p></div></div>
        </div>
        <div class="process-aside">
          <h3>Found an error?</h3>
          <p>Send the guide URL, the claim and your evidence. Substantive corrections update the guide and its review date.</p>
          <dl>
            <dt>Corrections</dt><dd><a href="mailto:research@liquiditypools.app">research@liquiditypools.app</a></dd>
            <dt>Policy</dt><dd><a href="/about/#editorial-policy">Editorial and corrections policy</a></dd>
            <dt>Publisher</dt><dd>SudoAI</dd>
            <dt>Source</dt><dd><a href="https://github.com/SudoAI-App/LiquidityPool" target="_blank" rel="noopener">github.com/SudoAI-App/LiquidityPool</a></dd>
          </dl>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var p0 = document.getElementById('mini-p0');
      var p1 = document.getElementById('mini-p1');
      var il = document.getElementById('mini-il');
      var note = document.getElementById('mini-note');
      var marker = document.getElementById('mini-marker');
      if (!p0 || !p1) return;
      function ilAt(k) { return 2 * Math.sqrt(k) / (1 + k) - 1; }
      function render() {
        var a = parseFloat(p0.value), b = parseFloat(p1.value);
        if (!(a > 0) || !(b >= 0)) {
          il.textContent = '—';
          note.textContent = 'Enter a positive deposit price.';
          return;
        }
        var k = b / a;
        var loss = k > 0 ? ilAt(k) : -1;
        var hodl = 5000 * k + 5000;
        var gap = Math.abs(hodl * loss);
        il.textContent = (loss < -0.000005 ? '−' : '') + Math.abs(loss * 100).toFixed(2) + '%';
        note.textContent = gap < 0.005
          ? 'No divergence: the prices have not moved relative to each other.'
          : '$10,000 in the pool trails holding by $' + gap.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' before fees.';
        if (marker) {
          var kc = Math.min(4, Math.max(0.25, k || 0.25));
          marker.setAttribute('cx', (8 + Math.log(kc / 0.25) / Math.log(16) * 264).toFixed(1));
          marker.setAttribute('cy', (10 + ilAt(kc) / -0.2 * 80).toFixed(1));
        }
      }
      p0.addEventListener('input', render);
      p1.addEventListener('input', render);
      render();
    })();
  </script>
</BaseLayout>
