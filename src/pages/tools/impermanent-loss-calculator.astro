---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Weighted & Range Impermanent Loss Calculator';
const description = 'Calculate impermanent loss for 50/50, weighted, and concentrated-liquidity ranges; chart price scenarios and share inputs with a URL.';
const canonical = 'https://liquiditypools.app/tools/impermanent-loss-calculator/';
const faq = [
  { q: 'Does this calculator support weighted pools?', a: 'Yes. Set token A to 50%, 80%, or 95%, or enter another two-token weight. The hold benchmark uses the same entry weights.' },
  { q: 'How are concentrated ranges different?', a: 'A bounded position changes token composition faster inside its selected range, then becomes one-sided after price leaves that range. The range model uses Uniswap v3 liquidity accounting rather than the full-range shortcut.' },
  { q: 'What does the curve show?', a: 'It holds every other input fixed and moves the relative price from 0.25× to 4× its entry level. The marked point is the current scenario.' },
  { q: 'Are calculator inputs sent anywhere?', a: 'No. The maths, chart, and share-link state run in your browser. The URL contains only the numbers visible in the form; no wallet or pool address is used.' },
];
const appSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication', name: title, url: canonical,
  applicationCategory: 'FinanceApplication', operatingSystem: 'Any', browserRequirements: 'Requires JavaScript',
  dateModified: '2026-09-13', description, isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'LiquidityPools.app', url: 'https://liquiditypools.app' },
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://liquiditypools.app/' },
  { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://liquiditypools.app/tools/' },
  { '@type': 'ListItem', position: 3, name: title, item: canonical },
] };
---
<BaseLayout title={`${title} — LiquidityPools.app`} description={description} image="/images/guides/impermanent-loss-calculator.webp">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="page-hero tool-hero"><div class="container">
    <p class="eyebrow">Calculator · free, no wallet connection</p>
    <h1 class="page-title">Impermanent loss calculator.</h1>
    <p>Compare holding with a 50/50 pool, a weighted pool, or a bounded concentrated range. The scenario curve and every input can travel in one shareable URL.</p>
  </div></section>

  <section class="section section--paper tool-section--first"><div class="container"><div class="tool-layout">
    <form class="tool-panel" id="il-form" data-calculator="impermanent_loss" novalidate>
      <h2>Position inputs</h2>
      <p class="tool-panel__note">Defaults describe ETH/USDC rising from 2,000 to 3,000. All calculations stay in this browser.</p>
      <div class="tool-field"><label for="mode">Pool model</label><select id="mode" name="mode"><option value="weighted">Full-range weighted pool</option><option value="concentrated">Concentrated price range</option></select></div>
      <div class="tool-grid-2">
        <div class="tool-field"><label for="priceA0">Token A price at deposit</label><input id="priceA0" type="number" step="any" min="0" value="2000" /></div>
        <div class="tool-field"><label for="priceA1">Token A price now</label><input id="priceA1" type="number" step="any" min="0" value="3000" /></div>
      </div>
      <div class="tool-grid-2">
        <div class="tool-field"><label for="priceB0">Token B price at deposit</label><input id="priceB0" type="number" step="any" min="0" value="1" /></div>
        <div class="tool-field"><label for="priceB1">Token B price now</label><input id="priceB1" type="number" step="any" min="0" value="1" /></div>
      </div>
      <div id="weighted-fields">
        <div class="tool-field"><label for="weightA">Token A pool weight (%)</label><input id="weightA" type="number" step="any" min="1" max="99" value="50" /><small>Token B receives the remainder. The hold benchmark uses the same entry weights.</small></div>
        <div class="tool-presets" role="group" aria-label="Weight presets"><button type="button" class="tool-preset" data-weight="50">50 / 50</button><button type="button" class="tool-preset" data-weight="80">80 / 20</button><button type="button" class="tool-preset" data-weight="95">95 / 5</button></div>
      </div>
      <div id="range-fields" hidden>
        <div class="tool-grid-2">
          <div class="tool-field"><label for="lowerPrice">Relative-price lower bound</label><input id="lowerPrice" type="number" step="any" min="0" value="1500" /></div>
          <div class="tool-field"><label for="upperPrice">Relative-price upper bound</label><input id="upperPrice" type="number" step="any" min="0" value="3500" /></div>
        </div><small>Bounds use token A priced in token B. The entry relative price must sit inside the range.</small>
      </div>
      <div class="tool-grid-2" style="margin-top:14px">
        <div class="tool-field"><label for="capital">Capital deployed</label><input id="capital" type="number" step="any" min="0" value="10000" /></div>
        <div class="tool-field"><label for="fees">Fees earned</label><input id="fees" type="number" step="any" min="0" value="260" /></div>
      </div>
      <div class="tool-field"><label for="days">Days held</label><input id="days" type="number" step="1" min="1" value="45" /></div>
      <div class="tool-presets" role="group" aria-label="Price scenario presets"><button type="button" class="tool-preset" data-ratio="1.25">A up 25%</button><button type="button" class="tool-preset" data-ratio="1.5">A up 50%</button><button type="button" class="tool-preset" data-ratio="2">A doubles</button><button type="button" class="tool-preset" data-ratio="0.5">A halves</button></div>
      <button type="button" class="tool-share" id="share-link">Copy shareable URL</button><span class="tool-share__status" id="share-status" aria-live="polite"></span>
    </form>

    <div class="tool-result tool-result--above-fold" aria-live="polite">
      <h2>Result</h2>
      <div class="tool-headline"><span>Impermanent loss vs. holding</span><strong id="out-il">−2.02%</strong><em id="out-ratio">Relative price ratio = 1.5000</em></div>
      <div class="tool-rows">
        <div class="tool-row"><span>Value if you had held</span><strong id="out-hodl">$12,500.00</strong></div><div class="tool-row"><span>Pool value before fees</span><strong id="out-pool">$12,247.45</strong></div><div class="tool-row tool-row--loss"><span>Divergence</span><strong id="out-div">−$252.55</strong></div><div class="tool-row"><span>Fees collected</span><strong id="out-fees">$260.00</strong></div><div class="tool-row tool-row--net"><span>Net result vs. holding</span><strong id="out-net">+$7.45</strong></div><div class="tool-row"><span>Fee income needed to break even</span><strong id="out-breakeven">$252.55</strong></div><div class="tool-row"><span>Annualised fee yield</span><strong id="out-apr">21.1%</strong></div>
      </div>
      <figure class="tool-chart"><svg id="il-chart" viewBox="0 0 640 240" role="img" aria-labelledby="il-chart-title il-chart-desc"><title id="il-chart-title">Impermanent loss across relative-price scenarios</title><desc id="il-chart-desc">A curve from one quarter to four times the entry relative price.</desc><line x1="44" y1="20" x2="44" y2="206"></line><line x1="44" y1="20" x2="624" y2="20"></line><polyline id="il-curve" points=""></polyline><circle id="il-marker" r="5" cx="334" cy="50"></circle><text x="44" y="228">0.25×</text><text x="319" y="228">1×</text><text x="600" y="228">4×</text></svg><figcaption id="chart-caption">50/50 full-range curve; current scenario marked.</figcaption></figure>
      <p class="tool-verdict" id="out-verdict">Fee income has covered the divergence over this holding period.</p>
      <p class="tool-disclaimer">Educational model only. Excludes gas, price impact, emissions, rebalancing, and path-dependent loss. Not financial advice.</p>
      <nav class="tool-next" aria-label="Understand this result"><span>Verify the model</span><a href="/methodology/" data-cta="calculator_methodology">Formulas and worked test cases</a><a href="/guides/impermanent-loss-explained/" data-cta="calculator_result_link">Impermanent loss explained</a><a href="/tools/uniswap-v3-liquidity-calculator/" data-cta="calculator_result_link">Full concentrated-liquidity calculator</a></nav>
    </div>
  </div></div></section>

  <section class="section section--mist" style="padding-top:72px;padding-bottom:72px"><div class="container"><div class="guide-layout">
    <aside class="guide-aside"><h2>Related reading</h2><a href="/guides/impermanent-loss-formula/">The IL formula</a><a href="/guides/balancer-and-weighted-pools/">Weighted pools</a><a href="/guides/out-of-range-liquidity/">Out-of-range liquidity</a></aside>
    <div class="article-content">
      <h2>Two models, two reserve rules</h2><p>A full-range weighted pool follows a constant-mean invariant. Its loss against the matching hold basket is:</p><p class="formula-display"><code>ILw(k) = kʷ ÷ (w·k + 1 − w) − 1</code></p><p><strong>Where:</strong></p><ul class="formula-glossary"><li><code>w</code> — token A’s entry weight.</li><li><code>k</code> — the relative price ratio between the assets.</li></ul><p>Setting <code>w = 0.5</code> gives the familiar 50/50 result. The range mode calculates bounded-liquidity inventory, values the same entry tokens at the end price as the hold benchmark, and compares that with the rebalanced position. After price crosses a bound, the position is one-sided.</p>
      <h2>How to read the chart</h2><p>The horizontal axis is the relative price change between the assets, not token A’s standalone dollar return. The vertical distance below zero is the pool’s shortfall against holding before fees. Change the weight or range and the curve is recomputed locally.</p>
      <h2>What the share link contains</h2><p>The query string records the selected model, prices, capital, fees, holding period, weight, and range bounds. Loading that URL restores the form. The canonical tag remains the clean path, so parameter combinations are not separate indexable pages.</p>
      <h2>Limits and risk</h2><p>Endpoint models do not measure loss-versus-rebalancing along the path, gas, slippage, tick rounding, inactive time, or changing liquidity competition. Fees entered here are observed income, not a forecast. Use the output as a scenario check, not a return promise.</p>
      <h2 id="sources">Sources</h2><ol class="tool-sources"><li><a href="https://uniswap.org/whitepaper.pdf" target="_blank" rel="noopener">Uniswap v2 Core Whitepaper</a></li><li><a href="https://uniswap.org/whitepaper-v3.pdf" target="_blank" rel="noopener">Uniswap v3 Core Whitepaper</a></li><li><a href="https://docs.balancer.fi/concepts/explore-available-balancer-pools/weighted-pool/weighted-pool.html" target="_blank" rel="noopener">Balancer weighted-pool documentation</a></li></ol>
      <div class="faq-block"><h2>Frequently asked questions</h2>{faq.map((item) => <details class="faq-item"><summary><h3>{item.q}</h3></summary><p>{item.a}</p></details>)}</div>
    </div><aside class="guide-aside"><h2>Method</h2><p>No inputs are transmitted, stored, or logged.</p><a href="/methodology/">Review formulas and tests</a></aside>
  </div></div></section>

  <script>
    // @ts-nocheck -- DOM nodes are guaranteed by the static template above.
    import { calculateWeightedPosition, weightedIlCurve } from '../../lib/calculators/impermanent-loss.mjs';
    import { calculateConcentratedPosition, concentratedIlCurve } from '../../lib/calculators/concentrated-liquidity.mjs';
    import { decodeImpermanentLossState, encodeImpermanentLossState } from '../../lib/calculators/url-state.mjs';
    const ids = ['mode', 'priceA0', 'priceA1', 'priceB0', 'priceB1', 'capital', 'fees', 'days', 'weightA', 'lowerPrice', 'upperPrice'];
    const el = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
    const out = Object.fromEntries(['il', 'ratio', 'hodl', 'pool', 'div', 'fees', 'net', 'breakeven', 'apr', 'verdict'].map((key) => [key, document.getElementById(`out-${key}`)]));
    const money = (value) => `${value < 0 ? '−' : ''}$${Math.abs(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const signedMoney = (value) => Math.abs(value) < 0.005 ? '$0.00' : `${value > 0 ? '+' : '−'}$${Math.abs(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    const percent = (value) => `${value < 0 ? '−' : value > 0 ? '+' : ''}${Math.abs(value * 100).toFixed(2)}%`;
    const value = (id) => Number(el[id].value);
    const state = () => ({ mode: el.mode.value, priceA0: value('priceA0'), priceA1: value('priceA1'), priceB0: value('priceB0'), priceB1: value('priceB1'), capital: value('capital'), feesEarned: value('fees'), days: value('days'), weightA: value('weightA') / 100, lowerPrice: value('lowerPrice'), upperPrice: value('upperPrice') });
    function drawCurve(points, currentRatio, caption) {
      const minLoss = Math.min(-0.01, ...points.map((point) => point.impermanentLoss));
      document.getElementById('il-curve').setAttribute('points', points.map((point, index) => `${44 + index / (points.length - 1) * 580},${20 + point.impermanentLoss / minLoss * 186}`).join(' '));
      const markerIndex = Math.max(0, Math.min(points.length - 1, Math.round(Math.log(currentRatio / 0.25) / Math.log(16) * (points.length - 1))));
      const marker = points[markerIndex];
      document.getElementById('il-marker').setAttribute('cx', String(44 + markerIndex / (points.length - 1) * 580)); document.getElementById('il-marker').setAttribute('cy', String(20 + marker.impermanentLoss / minLoss * 186)); document.getElementById('chart-caption').textContent = caption;
    }
    function render(updateUrl = false) {
      const input = state(); document.getElementById('weighted-fields').hidden = input.mode !== 'weighted'; document.getElementById('range-fields').hidden = input.mode !== 'concentrated';
      try {
        let result; let points; const entryRelative = input.priceA0 / input.priceB0; const exitRelative = input.priceA1 / input.priceB1; const ratio = exitRelative / entryRelative;
        if (input.mode === 'weighted') { result = calculateWeightedPosition(input); points = weightedIlCurve(input.weightA); drawCurve(points, ratio, `${Math.round(input.weightA * 100)}/${Math.round((1 - input.weightA) * 100)} full-range curve; current scenario marked.`); }
        else { const range = calculateConcentratedPosition({ entryPrice: entryRelative, exitPrice: exitRelative, lowerPrice: input.lowerPrice, upperPrice: input.upperPrice, capital: input.capital }); result = { ...range, poolValue: range.positionValue, feesEarned: input.feesEarned, netVsHold: range.divergence + input.feesEarned, feeAprPercent: input.feesEarned / input.capital * (365 / Math.max(1, input.days)) * 100 }; points = concentratedIlCurve({ entryPrice: entryRelative, lowerPrice: input.lowerPrice, upperPrice: input.upperPrice, capital: input.capital }); drawCurve(points, ratio, `Range ${input.lowerPrice.toLocaleString()}–${input.upperPrice.toLocaleString()}; current scenario marked.`); }
        out.il.textContent = percent(result.impermanentLoss); out.ratio.textContent = `Relative price ratio = ${ratio.toFixed(4)} · ${input.mode === 'weighted' ? 'weighted full range' : `${result.rangeState} range`}`; out.hodl.textContent = money(result.holdValue); out.pool.textContent = money(result.poolValue); out.div.textContent = signedMoney(result.divergence); out.fees.textContent = money(input.feesEarned); out.net.textContent = signedMoney(result.netVsHold); out.breakeven.textContent = money(Math.abs(result.divergence)); out.apr.textContent = `${result.feeAprPercent.toFixed(1)}%`; out.verdict.textContent = result.netVsHold >= 0 ? 'Entered fee income covers the modeled divergence for this scenario.' : `Holding the entry basket is ahead by ${money(Math.abs(result.netVsHold))} after entered fees.`;
        if (updateUrl) history.replaceState(null, '', `${location.pathname}?${encodeImpermanentLossState(input)}${location.hash}`);
      } catch (error) { out.verdict.textContent = error instanceof Error ? error.message : 'Check the inputs and try again.'; }
    }
    if (location.search) { const restored = decodeImpermanentLossState(location.search); el.mode.value = restored.mode; for (const id of ['priceA0', 'priceA1', 'priceB0', 'priceB1', 'capital', 'days', 'lowerPrice', 'upperPrice']) el[id].value = String(restored[id]); el.fees.value = String(restored.feesEarned); el.weightA.value = String(restored.weightA * 100); }
    ids.forEach((id) => { el[id].addEventListener('input', () => render(true)); el[id].addEventListener('change', () => render(true)); });
    document.querySelectorAll('[data-ratio]').forEach((button) => button.addEventListener('click', () => { el.priceA1.value = String(value('priceA0') * Number(button.dataset.ratio)); render(true); }));
    document.querySelectorAll('[data-weight]').forEach((button) => button.addEventListener('click', () => { el.weightA.value = button.dataset.weight; render(true); }));
    document.getElementById('share-link').addEventListener('click', async () => { const url = `${location.origin}${location.pathname}?${encodeImpermanentLossState(state())}`; try { await navigator.clipboard.writeText(url); document.getElementById('share-status').textContent = 'Copied.'; } catch { document.getElementById('share-status').textContent = 'Copy the URL from the address bar.'; } });
    render(false);
  </script>
</BaseLayout>
